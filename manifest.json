{
    "manifest_version": 3,
    "name": "Internet Package Analyzer",
    "version": "1.0",
    "description": "Parses internet packages, groups by time, and sorts by GB/RIAL value.",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "internet-package-analyzer@yourdomain.example",
            "strict_min_version": "115.0"
        }
    }
}
